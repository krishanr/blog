   "source": [
    "sparse_retriever = SparseRetriever(client, \"HotPotQA_sparse\")\n",
    "sparse_retriever.create_collection()\n",
    "qrels_subset, processed_data = sparse_retriever.index_dataset(\n",
    "    dataset.select(range(0, min(subset_size, len(dataset)))), corpus, qrels\n",
    ")"
   ]
  },
